{
  "name": "LearnKana",
  "version": 1,
  "surface": "homepage",
  "world": "transit signage typographic",
  "tokens": {
    "colors": {
      "paper": "#FFFFFF",
      "ink": "#14140F",
      "muted": "#5B5B53",
      "route": "#0B7A45",
      "seal": "#C4342B",
      "rule": "#E2E0D6",
      "night": "#14140F",
      "dark": {
        "paper": "#0D0E0B",
        "ink": "#F1F0E7",
        "route": "#46B87E",
        "seal": "#E0574C",
        "rule": "#24261F"
      }
    },
    "type": {
      "display": "Archivo 800 / uppercase / -0.03em",
      "heading": "Archivo 800",
      "body": "Noto Sans JP 400",
      "kana": "Noto Sans JP 700",
      "numbers": "Archivo 700 tabular"
    },
    "space": {
      "section": "clamp(56px, 8vw, 108px)",
      "wrap": "max 1180px, inline clamp(20px, 5vw, 48px)"
