  "motion": {
    "heroTitle": "kl-rise 700ms cubic-bezier(.16,1,.3,1)",
    "kana": "kl-ink clip-path 900ms",
    "baseline": "kl-fill scaleX 900ms",
    "stationDots": "kl-dot 420ms with 60ms stagger",
    "reducedMotion": "all entrance animation disabled"
  },
  "focus": {
    "ring": "2px solid #C4342B, offset 4px"
  },
  "rules": [
    "one primary action per viewport (seal vermilion)",
    "no gradients, glass, card shadows, kickers",
    "stations and counts come from curriculum data",
    "kana always lang=ja and set in Noto Sans JP"
  ]
